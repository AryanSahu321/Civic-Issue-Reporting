def process_sync_event(payload: dict):
    """Processes synchronous reporting event with circuit-breaker protection."""
    try:
        call_gpu_inference(payload)
        update_db_status(payload.get("report_id"), "Completed")
        logger.info(f"Report {payload.get('report_id')} processed successfully.")
    except Exception as e:
        logger.error(f"GPU processing failed/tripped: {e}")
        send_to_dlq(payload)